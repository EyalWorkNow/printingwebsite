# OpenAI-compatible chat API (DeepSeek default; OpenAI works too: https://api.openai.com/v1 + gpt-4o-mini)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Admin access = a site account with admin rights. Register at /account, then open /admin/setup and paste an owner secret
# (Supabase service_role key or the DB password; or set ADMIN_SETUP_CODE here). More admins: /admin/customers.
ADMIN_SETUP_CODE=

# New-order email. Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465 (app password, not your login password)
SMTP_URL=
NOTIFY_EMAIL=
# SITE_URL: optional on Vercel (defaults to the production domain)
SITE_URL=http://localhost:3007

# Customer files and product photos are stored in the business database below (no separate file storage needed).

# Business database (Postgres). Vercel: Storage → Create → Neon → connect to this project (sets DATABASE_URL).
DATABASE_URL=
