# OpenAI-compatible chat API (DeepSeek default; OpenAI works too: https://api.openai.com/v1 + gpt-4o-mini)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# /admin login (HTTP Basic). ADMIN_USER defaults to "admin"; password min 8 chars — admin is locked if unset.
ADMIN_USER=
ADMIN_PASSWORD=

# New-order email. Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465 (app password, not your login password)
SMTP_URL=
NOTIFY_EMAIL=
SITE_URL=http://localhost:3007
